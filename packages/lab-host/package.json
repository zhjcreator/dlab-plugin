{
  "name": "@dsh-lab/host",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Host composition bundle for the Deep Learning Lab \u2014 provides ctx.lab, /dlab RPC channel, lab_* model tools, DSH_LAB_* shell env, system-prompt section",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./rpc": {
      "types": "./lib/rpc-entry.d.ts",
      "default": "./lib/rpc-entry.js"
    },
    "./shell-env": {
      "types": "./lib/shell-env.d.ts",
      "default": "./lib/shell-env.js"
    },
    "./system-prompt": {
      "types": "./lib/system-prompt.d.ts",
      "default": "./lib/system-prompt.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-lab/shared": "workspace:*",
    "@dsh-lab/core": "workspace:*",
    "@dsh-lab/git": "workspace:*",
    "@dsh-lab/store": "workspace:*",
    "@dsh-lab/runner": "workspace:*",
    "@dsh-lab/scheduler": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1"
  }
}