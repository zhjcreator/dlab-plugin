{
  "name": "@dlab/lab-host",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Host composition bundle for the Deep Learning Lab — provides ctx.lab, /dlab RPC channel, lab_* model tools, DSH_LAB_* shell env, system-prompt section",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dlab/shared": "workspace:*",
    "@dlab/core": "workspace:*",
    "@dlab/git": "workspace:*",
    "@dlab/store": "workspace:*",
    "@dlab/runner": "workspace:*",
    "@dlab/scheduler": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
